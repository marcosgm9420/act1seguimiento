{
  "name": "gestion-di",
  "version": "0.0.1",
  "author": "Marcos Gomez",
  "scripts": {
    "set-env": "node scripts/set-env.mjs",
    "prestart": "npm run set-env",
    "start": "ng serve",
    "prebuild": "npm run set-env",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run set-env",
    "test": "ng test",
    "test:ci": "npm run set-env && ng test --watch=false",
    "lint": "ng lint",
    "docs": "compodoc -p tsconfig.doc.json -d docs/tecnica -n \"Gestión DI - Documentación técnica\" --language es-ES --hideGenerator",
    "docs:serve": "compodoc -p tsconfig.doc.json -s",
    "vercel-build": "npm run test:ci && npm run build && npm run docs:www",
    "docs:www": "compodoc -p tsconfig.doc.json -d www/docs -n \"Gestión DI - Documentación técnica\" --language es-ES --hideGenerator",
    "icons": "node scripts/generate-icons.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "^9.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "chart.js": "^4.6.1",
    "ionicons": "^8.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@capacitor/cli": "8.5.3",
    "@compodoc/compodoc": "^2.0.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~5.0.5"
  },
  "description": "Gestión DI: sistema de gestión de inventario multiplataforma (Ionic + Angular + Supabase)"
}
